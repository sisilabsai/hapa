<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Allow HTTP to local dev server — ExoPlayer (video_player) uses Android's
         native network stack which blocks cleartext by default on API 28+.
         Dart/Dio uses the Dart VM network stack and is unaffected, which is
         why API calls work but video playback fails without this flag. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
